{
  "name": "montaj-studio-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:app",
    "build:app": "npm --prefix ../app run build && node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../app/dist/montaj-studio.html','public/index.html');fs.cpSync('../app/public','public',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "npm run build:app && wrangler d1 migrations apply montaj-studio --remote && wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
